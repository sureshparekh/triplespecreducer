59], ["for", 43.999, 44.119], ["bit.", 44.199, 44.399]]}]}, {"id": "instrument", "t0": 45.939, "t1": 73.205, "lines": [{"shown": "TripleSpec is a cross-dispersed spectrograph on the four point one metre SOAR telescope.", "t0": 46.879, "t1": 52.02, "words": [["Triple", 46.879, 47.199], ["Spec", 47.239, 47.579], ["is", 47.839, 47.919], ["a", 47.979, 47.999], ["cross-dispersed", 48.059, 48.839], ["spectrograph", 48.919, 49.6], ["on", 49.68, 49.74], ["the", 49.76, 49.84], ["four", 49.92, 50.12], ["point", 50.2, 50.46], ["one", 50.64, 50.8], ["metre", 50.84, 51.1], ["soar", 51.16, 51.34], ["telescope.", 51.4, 52.02]]}, {"shown": "Light from a slit, thirty-eight arcseconds long, is spread out by a grating, and a prism separates the grating's orders. So one exposure holds five spectra, one above the other: orders three to seven, from zero point nine four to two point four seven microns, at a resolving power of about three and a half thousand.", "t0": 52.36, "t1": 71.685, "words": [["Light", 52.36, 52.56], ["from", 52.58, 52.72], ["a", 52.76, 52.78], ["slit,", 52.86, 53.1], ["thirty-eight", 53.14, 53.861], ["arcseconds", 53.981, 54.501], ["long,", 54.561, 54.861], ["is", 55.161, 55.241], ["spread", 55.281, 55.561], ["out", 55.601, 55.741], ["by", 55.781, 55.901], ["a", 55.941, 55.961], ["grating,", 56.061, 56.421], ["and", 56.701, 56.781], ["a", 56.801, 56.821], ["prism", 56.901, 57.241], ["separates", 57.401, 57.882], ["the", 57.922, 58.002], ["grating's", 58.062, 58.482], ["orders.", 58.542, 58.842], ["So", 59.262, 59.342], ["one", 59.502, 59.622], ["exposure", 59.642, 60.182], ["holds", 60.242, 60.482], ["five", 60.582, 60.862], ["spectra,", 60.902, 61.322], ["one", 61.762, 61.902], ["above", 62.002, 62.303], ["the", 62.303, 62.403], ["other:", 62.483, 62.683], ["orders", 63.083, 63.363], ["three", 63.443, 63.663], ["to", 63.743, 63.823], ["seven,", 63.943, 64.243], ["from", 64.503, 64.663], ["zero", 64.763, 64.983], ["point", 65.103, 65.343], ["nine", 65.403, 65.663], [