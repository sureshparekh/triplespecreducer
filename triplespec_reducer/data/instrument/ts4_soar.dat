#
# Generated by K. Allers August 2015
#
# This is the calibration file for the ARCoIRIS spectrograph on the Blanco.
# Note the values must be in the correct order, but can have any number of 
# spaces/comments between them.
#
#============================================================================
#
 INSTRUMENT=TS4_SOAR
 NCOLS=2048
 NROWS=1024
 STDIMAGE=1024
 PLOTWINSIZE=1024 512
 FILENAME=FILENAME
 EXPTIME=EXPTIME
 TIME=UT
 POSANGLE=ROTANG
 HA=HA
 AIRMASS=AIRMASS
 %don't know what NINT does
 NINT=4 
 NSUFFIX=6
 %BMASK needs to be created
 BADPIXMASK=fakebmask.fits
%
%CAL BASE
%
 CALMODULE=kna_ts41cals2d
%
%FILE READ MODE
%
 FILEREADMODE=Index
 IPREFIX=spc
 OPREFIX=spectra
 SUFFIX=*.fits*
 FITSREADPROGRAM=kna_readts4fits
%
% Reduction Mode
%
 REDUCTIONMODE=A-B
%
% Combine Base Information
%
 COMBMODE=A
 COMBSTAT=Robust Mean (Std Error)
 COMBTHRESH=8.0
 COMBODIR=proc/
%
%  Sky Base Information
%
 SKYSTAT=Robust Weighted Mean
 SKYTHRESH=8.0
%
% Profile Parameters
%
 YBUFFER=1
 OVERSAMP=2
 ATMOSTHRESH=0.4
%
% Point Source Base
%
PSNAPS=2
PSPSFRAD=2.2
PSAPRAD=1.0
PSBGSUB=1
PSBGSTART=2.5
PSBGWIDTH=5
PSBGDEG=1
%
% Extended Source Base
%
XSBGSUB=1
XSBG=0-2,13-15
XSBGDEG=0
%
%Other Base Parameters
%
 TRACEDEG=1
 TRACESTEP=5
 TRACESUMAP=5
 TRACEsIGTHRESH=0.1
 TRACEWINTHRESH=3
 BADPIXELTHRESH=7
#linear to 90000 e-
 LINCORMAX=80000.0 
 CHECKSEEING=0
 SEEINGTHRESH=3
 AMPCOR=0 1
 LINCORRECT=0 0
 ERRORPROPAGATION=1 1
 FLATFIELD=1 1
%Will want to change this if we get a bad pixel mask
 FIXBADPIXELS=0 0
 OPTIMALEXTRACTION=0 0
%
% FITS Header Keywords to Grab
%
KEYWORD=FILENAME
KEYWORD=OBJECT
KEYWORD=UT
KEYWORD=DATE
KEYWORD=EXPTIME
KEYWORD=RA
KEYWORD=DEC
KEYWORD=FSAMPLE
KEYWORD=COADDS
KEYWORD=AIRMASS
